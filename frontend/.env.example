# Backend API base URL (no trailing slash)
# Development:  http://localhost:5000/api
# Production:   https://your-backend.up.railway.app/api
VITE_API_URL=http://localhost:5000/api

# ── White-label branding (all optional — defaults to Samayapurathal Bankers) ──
# Brand display name shown in sidebar, header, login page, and reports
VITE_BRAND_NAME=Samayapurathal Bankers

# Short tagline shown below brand name (Tamil / any language)
VITE_BRAND_TAGLINE=தங்க நகை கடன்

# Alternate/full tagline shown on login page left panel
VITE_BRAND_TAGLINE_ALT=ஸ்ரீ சமயபுரத்தாள் தங்க நகை கடன்

# Logo path — place file in frontend/public/ and set path starting with /
# Leave blank to use the default bundled logo
VITE_BRAND_LOGO=/logo.jpeg

# Default interest rates (% per month) — user can still override per loan
VITE_GOLD_RATE=2
VITE_SILVER_RATE=4
