# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────
# MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/pawncalc?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/pawncalc

# ─── Authentication ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com
